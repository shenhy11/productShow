<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.support.mapper.FirmwareMapper">
  <select id="selectList" resultType="com.ruoyi.support.domain.Firmware">SELECT * FROM zc_firmware</select>
  <select id="selectById" resultType="com.ruoyi.support.domain.Firmware">SELECT * FROM zc_firmware WHERE id = #{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO zc_firmware (product_id,version,file_url,file_name,file_size,release_note_zh,release_note_en,release_date,status) VALUES (#{productId},#{version},#{fileUrl},#{fileName},#{fileSize},#{releaseNoteZh},#{releaseNoteEn},#{releaseDate},#{status})</insert>
  <update id="update">UPDATE zc_firmware SET product_id=#{productId},version=#{version},file_url=#{fileUrl},file_name=#{fileName},file_size=#{fileSize},release_note_zh=#{releaseNoteZh},release_note_en=#{releaseNoteEn},release_date=#{releaseDate},status=#{status} WHERE id = #{id}</update>
  <delete id="deleteById">DELETE FROM zc_firmware WHERE id = #{id}</delete>
</mapper>