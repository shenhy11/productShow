<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.support.mapper.SupportRequestMapper">
  <select id="selectList" resultType="com.ruoyi.support.domain.SupportRequest">SELECT * FROM zc_support_request</select>
  <select id="selectById" resultType="com.ruoyi.support.domain.SupportRequest">SELECT * FROM zc_support_request WHERE id = #{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO zc_support_request (name,email,product_model,subject,message,status,remark) VALUES (#{name},#{email},#{productModel},#{subject},#{message},#{status},#{remark})</insert>
  <update id="update">UPDATE zc_support_request SET name=#{name},email=#{email},product_model=#{productModel},subject=#{subject},message=#{message},status=#{status},remark=#{remark} WHERE id = #{id}</update>
  <delete id="deleteById">DELETE FROM zc_support_request WHERE id = #{id}</delete>
</mapper>