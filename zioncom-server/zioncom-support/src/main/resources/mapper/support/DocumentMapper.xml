<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.support.mapper.DocumentMapper">
  <select id="selectList" resultType="com.ruoyi.support.domain.Document">SELECT * FROM zc_document</select>
  <select id="selectById" resultType="com.ruoyi.support.domain.Document">SELECT * FROM zc_document WHERE id = #{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO zc_document (product_id,doc_type,title_zh,title_en,file_url,file_name,file_size,sort_order,status) VALUES (#{productId},#{docType},#{titleZh},#{titleEn},#{fileUrl},#{fileName},#{fileSize},#{sortOrder},#{status})</insert>
  <update id="update">UPDATE zc_document SET product_id=#{productId},doc_type=#{docType},title_zh=#{titleZh},title_en=#{titleEn},file_url=#{fileUrl},file_name=#{fileName},file_size=#{fileSize},sort_order=#{sortOrder},status=#{status} WHERE id = #{id}</update>
  <delete id="deleteById">DELETE FROM zc_document WHERE id = #{id}</delete>
</mapper>