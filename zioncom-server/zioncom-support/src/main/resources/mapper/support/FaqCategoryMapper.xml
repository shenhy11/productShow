<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.support.mapper.FaqCategoryMapper">
  <select id="selectList" resultType="com.ruoyi.support.domain.FaqCategory">SELECT * FROM zc_faq_category</select>
  <select id="selectById" resultType="com.ruoyi.support.domain.FaqCategory">SELECT * FROM zc_faq_category WHERE id = #{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO zc_faq_category (name_zh,name_en,sort_order,status) VALUES (#{nameZh},#{nameEn},#{sortOrder},#{status})</insert>
  <update id="update">UPDATE zc_faq_category SET name_zh=#{nameZh},name_en=#{nameEn},sort_order=#{sortOrder},status=#{status} WHERE id = #{id}</update>
  <delete id="deleteById">DELETE FROM zc_faq_category WHERE id = #{id}</delete>
</mapper>