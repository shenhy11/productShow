<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.product.mapper.ProductSpecMapper">
  <select id="selectList" resultType="com.ruoyi.product.domain.ProductSpec">SELECT * FROM zc_product_spec</select>
  <select id="selectById" resultType="com.ruoyi.product.domain.ProductSpec">SELECT * FROM zc_product_spec WHERE id = #{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO zc_product_spec (product_id,spec_group,spec_key,spec_value,sort_order) VALUES (#{productId},#{specGroup},#{specKey},#{specValue},#{sortOrder})</insert>
  <update id="update">UPDATE zc_product_spec SET product_id=#{productId},spec_group=#{specGroup},spec_key=#{specKey},spec_value=#{specValue},sort_order=#{sortOrder} WHERE id = #{id}</update>
  <delete id="deleteById">DELETE FROM zc_product_spec WHERE id = #{id}</delete>
</mapper>